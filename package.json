{
  "name": "career-ops",
  "version": "1.7.0",
  "description": "Joshua's personal job-search operating system",
  "scripts": {
    "doctor": "node doctor.mjs",
    "verify": "node verify-pipeline.mjs",
    "normalize": "node normalize-statuses.mjs",
    "dedup": "node dedup-tracker.mjs",
    "merge": "node merge-tracker.mjs",
    "pdf": "node generate-pdf.mjs",
    "sync-check": "node cv-sync-check.mjs",
    "liveness": "node check-liveness.mjs",
    "discover": "node scanner/scan.mjs",
    "discover:all": "node scanner/scan.mjs --all",
    "scan": "node scanner/scan.mjs",
    "scan:test": "node scanner/test/core.test.mjs && node scanner/test/validate-postings.test.mjs",
    "validate-postings": "node validate-postings.mjs"
  },
  "keywords": [
    "ai",
    "job-search",
    "career",
    "automation"
  ],
  "dependencies": {
    "dotenv": "^16.4.5",
    "js-yaml": "^5.3.0",
    "playwright": "^1.58.1"
  }
}
